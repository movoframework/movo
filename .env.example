# Movo environment — copy to `.env` and edit. `.env` is gitignored and must stay that way.
#
# A Movo resource server needs NO Stellar private key. It names an address to be paid and a
# price; the buyer signs. If you ever find yourself wanting to put a payer secret in this file
# for a server, something has gone wrong — see SECURITY.md.

# ---------------------------------------------------------------------------------------
# Facilitator
# ---------------------------------------------------------------------------------------

# The facilitator that verifies and settles payments. The default is free, keyless, and
# supports stellar:testnet. Also read by `pnpm generate:compat` and the conformance suite.
MOVO_FACILITATOR_URL=https://www.x402.org/facilitator

# ---------------------------------------------------------------------------------------
# Test gating
# ---------------------------------------------------------------------------------------

# Set to 1 to enable the `e2e` and `conformance` Vitest projects. These reach third-party
# services and real Stellar testnet; they are opt-in and never block the PR gate.
# MOVO_E2E=1

# ---------------------------------------------------------------------------------------
# Facilitator service (M6) — `apps/facilitator`
# ---------------------------------------------------------------------------------------
#
# THE SPONSOR SEED IS THIS SYSTEM'S HIGHEST-VALUE SECRET. It pays every fee and is the source
# account of every settled transaction. This file is the DEVELOPMENT path only. For pubnet,
# inject a KMS- or HSM-backed signer through `resolveFacilitatorConfig` instead — see
# docs/operating-a-facilitator/signers-and-channel-accounts.md.

MOVO_FACILITATOR_NETWORKS=stellar:testnet

# Comma-separated seeds, one per channel account. More accounts means more concurrent
# settlements: Stellar serialises transactions per source account by sequence number, so the
# pool size is the concurrency ceiling. Fund each from https://friendbot.stellar.org.
# MOVO_FACILITATOR_TESTNET_SIGNER_SEEDS=S...,S...

# Optional. When set, the settled transaction is wrapped in a fee bump whose fee source is
# this account, decoupling fee payment from sequence-number management.
# MOVO_FACILITATOR_TESTNET_FEE_BUMP_SEED=S...

# /ready reports not-ready when any sponsor holds less than this (AC6.9).
MOVO_FACILITATOR_TESTNET_SPONSOR_FLOOR_XLM=5

# pubnet has no public Soroban RPC default; naming a provider is mandatory there.
# MOVO_FACILITATOR_PUBNET_RPC_URL=https://...

# Caller auth. Unset means open and keyless, which is what the testnet deployment must be.
# MOVO_FACILITATOR_AUTH_MODE=bearer
# MOVO_FACILITATOR_API_KEYS=team-a:secret-one,team-b:secret-two:1200

# Rate limiting (set to `off` to disable) and the operator's own fee schedule, which is a
# configuration value and never hard-coded (RFP §3.1). Defaults to zero.
# MOVO_FACILITATOR_RATE_LIMIT=off
# MOVO_FACILITATOR_RATE_LIMIT_PER_KEY=600
# MOVO_FACILITATOR_RATE_LIMIT_PER_IP=120
# MOVO_FACILITATOR_SETTLE_FEE_STROOPS=0
