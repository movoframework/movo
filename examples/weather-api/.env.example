# weather-api — copy to .env and edit.
#
# This server needs NO Stellar private key. It names an address to be paid; the buyer signs.
# If you find yourself wanting to put a secret seed here, something has gone wrong — see
# SECURITY.md.

# The Stellar account that receives payment. A PUBLIC address, beginning with G.
# This value is published in the PAYMENT-REQUIRED header of every unpaid request, so it must
# never be a secret seed (those begin with S). Movo rejects an S-address at startup with
# MOVO_E_PAYTO_INVALID rather than letting one reach the wire.
MOVO_PAY_TO=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The facilitator that verifies and settles. The default is free, keyless, supports
# stellar:testnet, and sponsors network fees.
MOVO_FACILITATOR_URL=https://www.x402.org/facilitator

# Optional: the port to listen on.
# PORT=4021
