{
  "name": "@movoframework/cli",
  "version": "0.0.0",
  "description": "The movo command line interface",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "movo": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@movoframework/bazaar": "workspace:*",
    "@movoframework/core": "workspace:*",
    "@movoframework/server": "workspace:*",
    "@movoframework/stellar": "workspace:*",
    "@movoframework/testing": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "vitest": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "5.2.1",
    "vitest": "4.1.10"
  }
}
