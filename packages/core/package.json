{
  "name": "@movoframework/core",
  "version": "0.0.0",
  "description": "Movo project model, resource compilation, errors and the x402 protocol narrow waist",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/protocol/server.d.ts",
      "default": "./dist/protocol/server.js"
    },
    "./bazaar": {
      "types": "./dist/protocol/bazaar.d.ts",
      "default": "./dist/protocol/bazaar.js"
    },
    "./client": {
      "types": "./dist/protocol/client.d.ts",
      "default": "./dist/protocol/client.js"
    },
    "./facilitator": {
      "types": "./dist/protocol/facilitator.d.ts",
      "default": "./dist/protocol/facilitator.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@x402/core": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/stellar": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/fetch": "2.21.0"
  },
  "devDependencies": {
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
