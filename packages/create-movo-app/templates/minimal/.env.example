# Copy to .env. `.env` is gitignored; this file is not.
#
# Your Stellar account, which RECEIVES payment. This is a public address and is not a secret.
# A Movo resource server never signs anything and never needs a seed — if you are about to put
# an S… value in this file, stop and read docs/security/buyer-budgets.md.
MOVO_PAY_TO=G...

# The facilitator that verifies and settles. The default is free and needs no key.
MOVO_FACILITATOR_URL=https://www.x402.org/facilitator

# Only if your facilitator requires one. Never stored in config, never printed: `movo doctor`
# renders it as "configured (hidden)".
# MOVO_FACILITATOR_API_KEY=

# Needed only for `movo dev --facilitator in-process`, which signs and submits REAL testnet
# transactions. This is a BUYER key. Never set it on a production resource server.
# STELLAR_PRIVATE_KEY=
