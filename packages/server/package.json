{
  "name": "@movoframework/server",
  "version": "0.0.0",
  "description": "Mount compiled Movo resources onto a Node HTTP framework",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@movoframework/core": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "express": "5.2.1"
  }
}
